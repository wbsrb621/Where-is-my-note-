{
  "name": "where-is-my-note",
  "version": "1.0.0",
  "description": "Windows desktop memo manager with pinned desktop widgets.",
  "main": "main.js",
  "scripts": {
    "start": "node start-electron.js",
    "build": "electron-builder --win nsis",
    "publish": "electron-builder --win nsis --publish always"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/wbsrb621/Where-is-my-note-.git"
  },
  "build": {
    "appId": "com.jglim.wimn",
    "productName": "WIMN",
    "copyright": "Copyright (c) 2026 @j_glim",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "start-electron.js",
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "main.js"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/app-icon.ico",
      "publish": [
        {
          "provider": "github",
          "owner": "wbsrb621",
          "repo": "Where-is-my-note-"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "WIMN",
      "artifactName": "WIMN-Setup-${version}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^39.8.5",
    "electron-builder": "^26.8.1",
    "png-to-ico": "^3.0.1"
  },
  "dependencies": {
    "electron-updater": "^6.8.3"
  }
}
